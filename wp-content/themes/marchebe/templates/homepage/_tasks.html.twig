<section class="container mx-auto px-4 md:px-6 pb-12 md:pb-16" aria-labelledby="home-tasks">
    <h2 id="home-tasks" tabindex="-1" class="type-headline focus:outline-none">
        Services les plus demandés
    </h2>
    <ul class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 border-b border-rule">
        {% for task in tasks %}
            <li class="border-t border-rule">
                <a href="{{ task.url }}" class="home-task group block py-5">
                    <span class="home-task__title type-title block">
                        {{- task.name -}}
                        {% if task.external %}
                            <svg class="inline-block size-4 ms-1 align-[-0.1em] text-ink-soft" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                            </svg>
                            <span class="sr-only">(autre site)</span>
                        {% endif %}
                    </span>
                    <span class="mt-1 block text-ink-soft">{{ task.description }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
</section>
