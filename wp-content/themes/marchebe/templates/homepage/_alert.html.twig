{% if alertPage and alertPage.post_status == 'publish' %}
    {# Dismissal is keyed to this alert and its last edit, so a new or updated alert always shows.
       Dismissing folds the band away (no page jump) and hands focus to the next section. #}
    <section
            id="home-alert"
            x-data="{
                key: 'alertDismissed:{{ alertPage.ID }}:{{ alertPage.post_modified_gmt|date('U') }}',
                dismissed: false,
                dismiss() {
                    this.dismissed = true;
                    try { localStorage.setItem(this.key, Date.now()) } catch (e) {}
                    document.getElementById('home-tasks')?.focus({ preventScroll: true });
                }
            }"
            :class="{ 'is-dismissed': dismissed }"
            :inert="dismissed"
            class="home-alert"
            aria-label="Avis important">
        <div>
        <div class="pb-10 md:pb-12">
        <div class="bg-alert-bg border-y border-alert-rule text-alert-ink">
        <div class="container mx-auto px-4 md:px-6 py-4 flex items-start md:items-center gap-3 md:gap-4">
            <div class="hidden md:flex items-center shrink-0">
                <svg class="size-6" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3.25 2.25 16.75h15.5L10 3.25ZM10 8.5v3.75M10 14.5v.01"/></svg>
            </div>
            <div class="flex-1 min-w-0">
                <h2 class="font-bold text-lg break-words">
                    <a href="{{ alertPage.url }}" class="underline decoration-alert-ink/40 decoration-1 underline-offset-4 hover:decoration-alert-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-alert-ink">{{ alertPage.post_title }}</a>
                </h2>
                {% if alertPage.post_excerpt %}
                    <p class="mt-1">{{ alertPage.post_excerpt }}</p>
                {% endif %}
            </div>
            <a href="{{ alertPage.url }}"
               class="hidden md:inline-flex shrink-0 items-center gap-2 min-h-11 px-4 rounded-md border border-alert-ink/40 font-semibold hover:bg-alert-ink hover:text-alert-bg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-alert-ink">
                Lire la suite
                <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m-5-5 5 5-5 5"/></svg>
            </a>
            <button type="button" @click="dismiss()"
                    class="shrink-0 size-11 inline-flex items-center justify-center rounded-md hover:bg-alert-ink/10 transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-alert-ink"
                    aria-label="Masquer cet avis">
                <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"/></svg>
            </button>
        </div>
        </div>
        </div>
        </div>
    </section>
    <script>
        {# Hide an already-dismissed alert before first paint, so it never flashes in and out. #}
        try {
            if (localStorage.getItem('alertDismissed:{{ alertPage.ID }}:{{ alertPage.post_modified_gmt|date('U') }}')) {
                document.getElementById('home-alert').hidden = true;
            }
        } catch (e) {}
    </script>
{% endif %}
