<section class="bg-vellum border-t border-rule py-16 sm:py-20">
    <div class="container mx-auto px-4">

        <div class="text-center">
            <h2 class="type-headline">
                Nos partenaires
            </h2>
        </div>

        <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-10 gap-y-8 md:gap-x-16">
            {% for item in partners %}
                <li>
                    <a
                            href="{{ item.url }}"
                            target="_blank" rel="noopener noreferrer" class="group">
                        <img
                                class="h-12 md:h-24 w-auto object-contain opacity-70 grayscale transition-[opacity,filter] duration-200 group-hover:opacity-100 group-hover:grayscale-0"
                                src="{{ template_directory }}/assets{{ item.img }}"
                                width="{{ item.width }}" height="{{ item.height }}"
                                loading="lazy" decoding="async"
                                alt="{{ item.alt }}"/>
                        <span class="sr-only">(nouvel onglet)</span>
                    </a>
                </li>
            {% endfor %}

        </ul>
    </div>
</section>