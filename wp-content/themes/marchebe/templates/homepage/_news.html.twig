<section class="flex flex-col h-full" aria-labelledby="home-news">
    <h2 id="home-news" class="type-headline mb-6">
        Actualités
    </h2>
    {% if sortLink %}
        {{ sortLink|raw }}
    {% endif %}
    {% if news is empty %}
        <p class="text-ink-soft">Aucune actualité publiée pour le moment.</p>
    {% else %}
        <ul class="grid md:grid-cols-2 gap-3 flex-1">
            {% for item in news %}
                <li class="h-full min-w-0 {% if loop.index > 3 %}hidden md:block{% endif %}">
                    <a
                            class="h-full flex flex-col bg-paper rounded-xl overflow-hidden border border-rule hover:shadow-hover transition-shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                            href="{{ item.link }}"
                    >
                        {% if item.post_thumbnail_url %}
                            <img
                                    src="{{ item.post_thumbnail_url }}"
                                    {% if item.post_thumbnail_srcset %}srcset="{{ item.post_thumbnail_srcset }}"{% endif %}
                                    {% if item.post_thumbnail_sizes %}sizes="{{ item.post_thumbnail_sizes }}"{% endif %}
                                    alt=""
                                    class="w-full h-44 object-cover"
                                    loading="lazy"
                            />
                        {% endif %}
                        <div class="p-4 flex-1">
                            <h3 class="type-title line-clamp-3 break-words">{{ item.post_title }}</h3>
                        </div>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    <div class="mt-auto pt-6">
        <a href="/actualites"
           class="inline-flex items-center gap-2 min-h-11 bg-paper text-ink font-semibold py-2.5 px-5 rounded-md border border-rule hover:bg-vellum transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            Toutes les actualités
            <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m-5-5 5 5-5 5"/></svg>
        </a>
    </div>
</section>
