{# not-prose: le contenu de page est dans .prose, qui imposerait ses marges et soulignements aux cartes #}
{# couleur du titre sur le lien: la regle "article h3" du theme (hors calques Tailwind) ecrase les utilitaires du h3 #}
<div class="not-prose">
    {% if publications is empty %}
        <p class="rounded-lg border border-rule bg-paper px-5 py-4 text-ink-soft">
            Les publications ne sont pas disponibles pour le moment.
        </p>
    {% else %}
        <p class="mb-5 text-sm text-ink-muted">
            {{ publications|length }} publications sur {{ total }}, de la plus récente à la plus ancienne.
            Source :
            <a href="{{ source }}" target="_blank" class="text-cta-dark underline underline-offset-2 hover:text-ink">deliberations.be</a>
        </p>

        <ol class="space-y-4">
            {% for publication in publications %}
                <li class="rounded-lg border border-slate-200 bg-white p-5 transition-all duration-200 hover:border-cta-dark hover:shadow-md">
                    <h3 class="text-lg font-semibold leading-snug">
                        <a href="{{ publication.url }}" target="_blank" class="text-ink hover:text-cta-dark hover:underline underline-offset-2">
                            {{ publication.title }}
                        </a>
                    </h3>

                    {% if publication.description and publication.description != publication.title %}
                        <p class="mt-2 line-clamp-3 text-ink-soft">{{ publication.description }}</p>
                    {% endif %}

                    <div class="mt-4 flex flex-wrap items-end justify-between gap-4 border-t border-rule pt-4">
                        <dl class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                            {% if publication.date %}
                                <div>
                                    <dt class="text-xs uppercase tracking-wide text-ink-muted">Date</dt>
                                    <dd class="font-medium text-ink">
                                        <time datetime="{{ publication.date }}">{{ publication.date|date('d/m/Y') }}</time>
                                    </dd>
                                </div>
                            {% endif %}
                            {% if publication.nature %}
                                <div>
                                    <dt class="text-xs uppercase tracking-wide text-ink-muted">Nature</dt>
                                    <dd class="font-medium text-ink">{{ publication.nature }}</dd>
                                </div>
                            {% endif %}
                            {% if publication.matiere %}
                                <div>
                                    <dt class="text-xs uppercase tracking-wide text-ink-muted">Matière</dt>
                                    <dd class="font-medium text-ink">{{ publication.matiere }}</dd>
                                </div>
                            {% endif %}
                        </dl>

                        {% if publication.pdf %}
                            <a href="{{ publication.pdf }}" target="_blank"
                               class="inline-flex items-center gap-2 rounded-lg bg-cta-dark px-4 py-2 text-sm font-semibold text-white transition duration-200 hover:brightness-90">
                                <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
                                Télécharger le PDF
                            </a>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ol>
    {% endif %}
</div>
